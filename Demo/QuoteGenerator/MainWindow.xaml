<Window x:Class="QuoteGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quote Generator" Height="780" Width="950"
        WindowStartupLocation="CenterScreen" Background="#f0f4f8">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2563eb"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#cbd5e1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#ef4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#dc2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2563eb" CornerRadius="6,6,0,0" Padding="16,12" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Quote Generator" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <Button Grid.Column="1" Content="Company Settings" Style="{StaticResource SecondaryButton}" Click="CompanySettings_Click"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,6,6" Padding="20" BorderBrush="#e2e8f0" BorderThickness="1,0,1,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Customer Info Section -->
                    <TextBlock Text="Customer Information" Style="{StaticResource HeaderText}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Customer Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCustomerName" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCustomerEmail" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCustomerPhone" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCustomerAddress" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,4,0,12" Background="#e2e8f0"/>

                    <!-- Add Item Section -->
                    <TextBlock Text="Add Part / Service" Style="{StaticResource HeaderText}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Part / Service" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbPartService" IsEditable="True" FontSize="13" Padding="4"
                                      SelectionChanged="CmbPartService_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtDescription" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Qty" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtQuantity" Style="{StaticResource InputBox}" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Unit Price ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtUnitPrice" Style="{StaticResource InputBox}" Text="0.00"/>
                        </StackPanel>
                        <Button Grid.Column="8" Content="Add Item" Style="{StaticResource ActionButton}"
                                VerticalAlignment="Bottom" Click="AddItem_Click" Margin="0,0,0,1"/>
                    </Grid>

                    <Separator Margin="0,8,0,12" Background="#e2e8f0"/>

                    <!-- Items List -->
                    <TextBlock Text="Quote Items" Style="{StaticResource HeaderText}"/>
                    <DataGrid x:Name="dgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="#e2e8f0" BorderThickness="1" MinHeight="120"
                              Background="White" RowBackground="White" AlternatingRowBackground="#f8fafc"
                              HorizontalGridLinesBrush="#f1f5f9" FontSize="13" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part / Service" Binding="{Binding PartOrService}" Width="2*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=\{0:C2\}}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=\{0:C2\}}" Width="100"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource DangerButton}" Click="RemoveItem_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total -->
                    <Border Background="#f0f4f8" CornerRadius="4" Padding="16,10" Margin="0,10,0,0"
                            HorizontalAlignment="Right" MinWidth="220">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Total:  " FontSize="18" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTotal" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#2563eb" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="Notes" Style="{StaticResource HeaderText}" Margin="0,16,0,6"/>
                    <TextBox x:Name="txtNotes" Style="{StaticResource InputBox}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Quote" Style="{StaticResource SecondaryButton}" Click="ClearQuote_Click" Margin="0,0,8,0"/>
                <Button Content="Save &amp; Preview Quote" Style="{StaticResource ActionButton}" Click="GenerateQuote_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
