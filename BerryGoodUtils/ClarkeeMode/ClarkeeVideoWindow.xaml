<Window x:Class="BerryGoodUtils.ClarkeeMode.ClarkeeVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clarkee Mode Complete" Height="520" Width="820" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#0f172a"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="You found all four Clarkees!" FontSize="22" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,0,0,14"/>

        <Border Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="videoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                              MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded"
                              MediaFailed="VideoPlayer_MediaFailed"/>
                <StackPanel x:Name="placeholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="Clarkee's grand finale is coming soon." Foreground="White" FontSize="20"
                               FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="placeholderDetail" Text="The player is ready for the finished video."
                               Foreground="#94a3b8" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnPlayPause" Content="Play" Style="{StaticResource SecondaryButton}"
                    IsEnabled="False" Click="PlayPause_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
