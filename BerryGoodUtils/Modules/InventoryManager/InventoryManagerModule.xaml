<UserControl x:Class="BerryGoodUtils.Modules.InventoryManager.InventoryManagerModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource BerryBlueBrush}" CornerRadius="6,6,0,0" Padding="16,12">
            <TextBlock Text="Inventory Manager" FontSize="22" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,6,6" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Parts List -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Inventory Parts" Style="{StaticResource HeaderText}"/>
                    <DataGrid x:Name="dgParts" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="200"
                              Background="White" RowBackground="White" AlternatingRowBackground="#f8fafc"
                              HorizontalGridLinesBrush="#f1f5f9" FontSize="13" IsReadOnly="True"
                              SelectionChanged="DgParts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Part #" Binding="{Binding PartNumber}" Width="*"/>
                            <DataGridTextColumn Header="Model #" Binding="{Binding ModelNumber}" Width="*"/>
                            <DataGridTextColumn Header="Serial #" Binding="{Binding SerialNumber}" Width="*"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding DefaultPrice, StringFormat=\{0:C2\}}" Width="90"/>
                            <DataGridTemplateColumn Header="Image" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding HasReferenceImage, Mode=OneWay}" IsEnabled="False" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource DangerButton}" Click="RemovePart_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Add New Part" Style="{StaticResource SecondaryButton}" Click="NewPart_Click" Margin="0,0,8,0"/>
                        <Button Content="Add Part from Image" Style="{StaticResource SecondaryButton}" Click="AddPartFromImage_Click" Margin="0,0,8,0"/>
                        <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Click="DeleteSelectedPart_Click"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Edit Form -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Part Details" Style="{StaticResource HeaderText}"/>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtName" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtManufacturer" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Equipment Type" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEquipmentType" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Part Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPartNumber" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Model Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtModelNumber" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSerialNumber" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reference Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtReferenceNumber" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Additional Identifier" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtAdditionalIdentifier" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDescription" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default Price ($)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDefaultPrice" Style="{StaticResource InputBox}" Text="0.00"/>
                            </StackPanel>
                        </Grid>

                        <Expander Header="Technical Specifications" Margin="0,0,0,12" IsExpanded="False"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Voltage" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtVoltage" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Amps" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtAmps" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Frequency" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtFrequency" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Phase" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtPhase" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="Horsepower" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtHorsepower" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Text="kW" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtKilowatts" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="IP Rating" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtIPRating" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Refrigerant" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtRefrigerant" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Refrigerant Charge" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtRefrigerantCharge" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Max Cell Pressure" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMaxCellPressure" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="Max Pressure" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMaxPressure" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Text="Max Head" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMaxHead" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="0">
                                        <TextBlock Text="Target Output" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtTargetOutput" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="2">
                                        <TextBlock Text="Gross Weight" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtGrossWeight" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Approval Number" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtApprovalNumber" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Build Date" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtBuildDate" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtBarcode" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Country of Mfg" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtCountryOfManufacture" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNotes" Style="{StaticResource InputBox}" AcceptsReturn="True"
                                                 TextWrapping="Wrap" Height="50" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="Reference Image" Style="{StaticResource HeaderText}"/>
                        <Border x:Name="imageBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8" Background="#f8fafc" Margin="0,0,0,8" MinHeight="100">
                            <Image x:Name="imgReference" Stretch="Uniform" MaxHeight="140"/>
                        </Border>
                        <TextBlock x:Name="txtImagePath" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="Browse..." Style="{StaticResource SecondaryButton}" Click="BrowseImage_Click" Margin="0,0,8,0"/>
                            <Button Content="Clear Image" Style="{StaticResource DangerButton}" Click="ClearImage_Click"/>
                        </WrapPanel>

                        <Expander Header="Fields to Include in Emails" Margin="0,0,0,12" IsExpanded="False"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8">
                                    Checked fields are shown when this part is added to a part request or quote email. Empty fields are always hidden.
                                </TextBlock>
                                <WrapPanel x:Name="wpEmailFields"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Check All" Style="{StaticResource SecondaryButton}" Click="EmailFields_CheckAll_Click" Margin="0,0,8,0" Padding="10,4"/>
                                    <Button Content="Uncheck All" Style="{StaticResource SecondaryButton}" Click="EmailFields_UncheckAll_Click" Padding="10,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Button Content="Save Part" Style="{StaticResource ActionButton}" Click="SavePart_Click" HorizontalAlignment="Right"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <TextBlock Text="Changes are saved automatically when you click Save Part." 
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
