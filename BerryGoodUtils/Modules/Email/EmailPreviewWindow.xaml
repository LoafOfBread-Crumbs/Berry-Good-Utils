<Window x:Class="BerryGoodUtils.Modules.Email.EmailPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Email Preview" Height="640" Width="900" MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#f8fafc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="txtAccount" VerticalAlignment="Center" FontWeight="SemiBold" Text="Gmail: Checking account..."/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="btnCompanyDetails" Content="Edit Company Details" Click="CompanyDetails_Click" Padding="10,5" Margin="0,0,8,4"/>
                <Button x:Name="btnSignIn" Content="Sign in / Change account" Click="SignIn_Click" Padding="10,5" Margin="0,0,8,4"/>
                <Button x:Name="btnSignOut" Content="Sign out" Click="SignOut_Click" Padding="10,5" Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="To" VerticalAlignment="Center"/><TextBox x:Name="txtTo" Grid.Column="1" Padding="6"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="CC" VerticalAlignment="Center"/><TextBox x:Name="txtCc" Grid.Column="1" Padding="6" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" Text="BCC" VerticalAlignment="Center"/><TextBox x:Name="txtBcc" Grid.Column="3" Padding="6"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Subject" VerticalAlignment="Center"/><TextBox x:Name="txtSubject" Grid.Column="1" Padding="6"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Message" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <TextBox x:Name="txtIntroduction" Grid.Column="1" Height="90" Padding="6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Introduction_Changed"/>
        </Grid>
        <GroupBox Grid.Row="5" Header="Email body preview" Margin="0,0,0,12" MinHeight="120">
            <wv2:WebView2 x:Name="browserPreview" DefaultBackgroundColor="White"/>
        </GroupBox>
        <Border Grid.Row="6" Background="#f8fafc" Padding="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0"/>
                <Button x:Name="btnSend" Content="Send Email" Click="Send_Click" Padding="18,7" Background="{StaticResource BerryBlueBrush}" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
