<Window x:Class="BerryGoodUtils.Modules.PartRequest.PartRequestOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Request As" Height="220" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f0f4f8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Generate request as..." FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource BerryBlueBrush}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="HTML Preview" Style="{StaticResource ActionButton}" Click="Html_Click" Margin="0,0,8,0"/>
            <Button Content="Plain-Text Email" Style="{StaticResource SecondaryButton}" Click="Text_Click"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"
                HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
