<UserControl x:Class="BerryGoodUtils.Modules.PartRequest.PartRequestModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource BerryBlueBrush}" CornerRadius="6,6,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Part Request" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <Button Grid.Column="1" Content="Company Settings" Style="{StaticResource SecondaryButton}" Click="CompanySettings_Click"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,6,6" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Supplier Selection -->
                    <TextBlock Text="Supplier" Style="{StaticResource HeaderText}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Select Supplier" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbSupplier" DisplayMemberPath="Name" FontSize="13" Padding="4"
                                      SelectionChanged="CmbSupplier_SelectionChanged"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="New Supplier" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Bottom" Click="NewSupplier_Click" Margin="0,0,0,1"/>
                    </Grid>

                    <Separator Margin="0,4,0,12" Background="{StaticResource BorderBrush}"/>

                    <!-- Add Item Section -->
                    <TextBlock Text="Request Part / Service" Style="{StaticResource HeaderText}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Part / Service" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbPartService" IsEditable="True" FontSize="13" Padding="4"
                                      SelectionChanged="CmbPartService_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Qty Needed" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtQuantity" Style="{StaticResource InputBox}" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,8,0">
                            <CheckBox x:Name="chkAttachReferenceImage" Content="Attach reference image" IsEnabled="False"
                                      FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="6" Content="Add Item" Style="{StaticResource ActionButton}"
                                VerticalAlignment="Bottom" Click="AddItem_Click" Margin="0,0,0,1"/>
                    </Grid>

                    <Separator Margin="0,8,0,12" Background="{StaticResource BorderBrush}"/>

                    <!-- Items List -->
                    <TextBlock Text="Requested Items" Style="{StaticResource HeaderText}"/>
                    <DataGrid x:Name="dgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="120"
                              Background="White" RowBackground="White" AlternatingRowBackground="#f8fafc"
                              HorizontalGridLinesBrush="#f1f5f9" FontSize="13" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part / Service" Binding="{Binding PartOrService}" Width="*"/>
                            <DataGridTextColumn Header="Qty Needed" Binding="{Binding Quantity}" Width="120"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource DangerButton}" Click="RemoveItem_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Separator Margin="0,16,0,12" Background="{StaticResource BorderBrush}"/>

                    <!-- Image Attachments -->
                    <TextBlock Text="Image Attachments" Style="{StaticResource HeaderText}"/>
                    <Border x:Name="dropZone" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                            CornerRadius="6" Padding="16" Background="#f8fafc" Margin="0,0,0,8"
                            AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" DragLeave="DropZone_DragLeave">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Drag and drop images here" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                                <TextBlock Text="or" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,4"/>
                                <Button Content="Click to Attach Images" Style="{StaticResource SecondaryButton}"
                                        Click="AttachImages_Click" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lbAttachments" MaxHeight="120" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" Background="White" FontSize="13">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                               ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="Remove" Style="{StaticResource DangerButton}"
                                            Click="RemoveAttachment_Click" Tag="{Binding}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Clear Request" Style="{StaticResource SecondaryButton}" Click="ClearRequest_Click" Margin="0,0,8,8"/>
                <Button Content="Save HTML" Style="{StaticResource SecondaryButton}" Click="SaveHtml_Click" Margin="0,0,8,8"/>
                <Button Content="Save Plain Text" Style="{StaticResource SecondaryButton}" Click="SaveText_Click" Margin="0,0,8,8"/>
                <Button Content="Email Request" Style="{StaticResource ActionButton}" Click="EmailRequest_Click" Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
