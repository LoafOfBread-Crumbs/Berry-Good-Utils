<Window x:Class="BerryGoodUtils.Modules.SupplierPortal.SupplierPortalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Supplier Portal" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#f0f4f8">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="tbTitle" Text="New Supplier" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource BerryBlueBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Supplier Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtSupplierName" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Company" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtCompany" Style="{StaticResource InputBox}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtPhone" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtAddress" Style="{StaticResource InputBox}" Height="50"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Portal Links" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BerryBlueBrush}" Margin="0,0,0,8"/>

                        <ItemsControl Grid.Row="1" x:Name="icPortalLinks" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="URL" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="Remove" VerticalAlignment="Bottom"
                                                Style="{StaticResource DangerButton}" Click="RemoveLink_Click" Tag="{Binding}" Margin="0,0,0,8"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Row="2" Content="+ Add Portal Link" Style="{StaticResource SecondaryButton}" Click="AddLink_Click" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"
                    Background="#e2e8f0" Foreground="#334155" BorderThickness="0" FontSize="13" Cursor="Hand"/>
            <Button Content="Save" Padding="16,8" Click="Save_Click"
                    Background="{StaticResource BerryBlueBrush}" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
