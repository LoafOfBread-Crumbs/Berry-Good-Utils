<UserControl x:Class="BerryGoodUtils.Modules.SupplierPortal.SupplierPortalModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Suppliers list -->
        <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Suppliers" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="dgSuppliers" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="200"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f8fafc"
                          HorizontalGridLinesBrush="#f1f5f9" FontSize="13" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="DgSuppliers_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="Add Supplier" Style="{StaticResource SecondaryButton}" Click="AddSupplier_Click" Margin="0,0,8,8"/>
                    <Button x:Name="btnEditSupplier" Content="Edit" Style="{StaticResource SecondaryButton}" Click="EditSupplier_Click" IsEnabled="False" Margin="0,0,8,8"/>
                    <Button x:Name="btnDeleteSupplier" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteSupplier_Click" IsEnabled="False" Margin="0,0,8,8"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Supplier details -->
        <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="tbSelectedSupplier" Text="Select a supplier to view portals" FontSize="18" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,16"/>

                <Grid Grid.Row="1" x:Name="gridSupplierDetails" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone:" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,12,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbPhone" Text="-" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,12,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbEmail" Text="-" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Address:" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,12,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbAddress" Text="-" TextWrapping="Wrap" Margin="0,0,0,6"/>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Portal Links" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>
                        <WrapPanel x:Name="wpPortalLinks" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <TextBlock x:Name="tbNoLinks" Text="No portal links saved for this supplier." FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
