<UserControl x:Class="BerryGoodUtils.Modules.CustomerManagement.CustomerManagementModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Customers" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" x:Name="dgCustomers" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="200"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f8fafc"
                          HorizontalGridLinesBrush="#f1f5f9" FontSize="13" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="DgCustomers_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Bottom Actions -->
        <Border Grid.Row="1" Margin="0,10,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Add Customer" Style="{StaticResource SecondaryButton}" Click="AddCustomer_Click" Margin="0,0,8,8"/>
                <Button x:Name="btnEdit" Content="Edit Selected" Style="{StaticResource SecondaryButton}" Click="EditCustomer_Click" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="btnOpenFolder" Content="Open Folder" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="btnSchedule" Content="Schedule" Style="{StaticResource SecondaryButton}" Click="ScheduleCustomer_Click" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="btnDelete" Content="Delete Selected" Style="{StaticResource DangerButton}" Click="DeleteCustomer_Click" IsEnabled="False" Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
