<Window x:Class="BerryGoodUtils.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update" Height="460" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f0f4f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="A software update is available" FontSize="20" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Current version:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
            <TextBlock x:Name="tbCurrentVersion" Foreground="#64748b"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Latest version:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
            <TextBlock x:Name="tbLatestVersion" Foreground="#64748b"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Release notes" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="tbReleaseNotes" TextWrapping="Wrap" Foreground="#334155"/>
            </ScrollViewer>
        </Border>

        <ProgressBar Grid.Row="5" x:Name="progressBar" Minimum="0" Maximum="1" Height="18" Margin="0,16,0,0" Visibility="Collapsed"/>
        <TextBlock Grid.Row="5" x:Name="tbStatus" Margin="0,16,0,0" Foreground="#334155" Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnDownload" Content="Download &amp; Install Update" Style="{StaticResource ActionButton}" Click="Download_Click" Margin="0,0,8,0"/>
            <Button Content="Later" Style="{StaticResource SecondaryButton}" Click="Later_Click"/>
        </StackPanel>
    </Grid>
</Window>
